# seq4h button map for the Anbernic RG40XX-V under Knulli.
# Copy next to the seq4h binary. Each line: SOURCE CODE BUTTON. Later lines win.
# Buttons: up down left right a b x y l r l2 r2 select start menu page roll undo lock quit none
# Run "./seq4h --show-input" to see the code each button sends.

# Read the pad as a raw joystick. Some H700 pads report a GUID that SDL
# mistakes for another controller, which would scramble the buttons.
mode joystick

# Raw button indices on the RG40XX-V ("ANBERNIC-keys").
joy 0  a
joy 1  b
joy 2  y
joy 3  x
joy 4  l          # L1
joy 5  r          # R1
joy 10 l2         # L2: previous track
joy 11 r2         # R2: next track
joy 6  select
joy 7  start
joy 13 menu       # M, short press: main menu
# joy 8 is M held down; Knulli uses it for its own hotkeys, so seq4h leaves it alone.
# joy 9 is the stick press.
# joy 9 undo      # example: stick press undoes the last roll

# The D-pad is hat 0.
hat up    up
hat down  down
hat left  left
hat right right

# The left stick can drive the cursor too (axes 0 and 1):
# axis 0- left
# axis 0+ right
# axis 1- up
# axis 1+ down
